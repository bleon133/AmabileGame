  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9b23192f51e3a84d9430d19478cf1a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PergaminoTrigger
  requiredThisTag: Pergamino
  playerTag: Player
  textoPergamino: "Aviso a todos los guardias a cargo de mantener el orden en el
    mercado.\r\n\r\nLa entrada queda restringida \xFAnicamente a personal de la guardia
    y trabajadores encargados de la distribuci\xF3n de suministros, los trabajadores
    deben tener sus papeles en orden, la tolerancia para discrepancias es zero.\r\n\r\nNos
    han otorgado autorizaci\xF3n para usar fuerza letal en cualquier ciudadanos que
    se encuentre cometiendo los siguientes cr\xEDmenes:\r\n-Robo de suministros de
    alta importancia como comida o agua potable\r\n-En posesi\xF3n de cualquier tipo
    de arma o de objeto que podr\xEDa ser interpretado como arma\r\n-Disrupci\xF3n
    de las labores de los guardias\r\n-Disrupci\xF3n de las labores de los trabajadores\r\n-Participaci\xF3n
    en protestas\r\n-Actitudes sediciosas no espec\xEDficas\r\n\r\nDebido a la falta
    de un jurado queda a discreci\xF3n del guardia determinar si la persona estaba
    cometiendo el crimen y reportarlo apropiadamente.\r\n\r\nLa autorizaci\xF3n de
    fuerza letal ciudadanos que presenten cualquier de los siguientes s\xEDntomas
    se mantiene:\r\n-Piel p\xE1lida\r\n-Impedimento del habla\r\n-P\xE9rdida de cognici\xF3n\r\n-Hyper
    agresividad\r\n-P\xE9rdida de sensibilidad al dolor\r\n\r\nFuerza en fe y en
    el perd\xF3n de los dioses\r"
  openKeyKeyboard: 116
  allowGamepadOpen: 1
  openButtonGamepad: 0
  closeKeyKeyboard: 120
  allowGamepadClose: 1
  closeButtonGamepad: 2
  onEnter:
    m_PersistentCalls:
      m_Calls:
