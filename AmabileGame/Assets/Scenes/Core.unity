  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Aviso a todos los guardias a cargo de mantener el orden en el mercado.\r\n\r\nLa
    entrada queda restringida \xFAnicamente a personal de la guardia y trabajadores
    encargados de la distribuci\xF3n de suministros, los trabajadores deben tener
    sus papeles en orden, la tolerancia para discrepancias es zero.\r\n\r\nNos han
    otorgado autorizaci\xF3n para usar fuerza letal en cualquier ciudadanos que se
    encuentre cometiendo los siguientes cr\xEDmenes:\r\n-Robo de suministros de alta
    importancia como comida o agua potable\r\n-En posesi\xF3n de cualquier tipo de
    arma o de objeto que podr\xEDa ser interpretado como arma\r\n-Disrupci\xF3n de
    las labores de los guardias\r\n-Disrupci\xF3n de las labores de los trabajadores\r\n-Participaci\xF3n
    en protestas\r\n-Actitudes sediciosas no espec\xEDficas\r\n\r\nDebido a la falta
    de un jurado queda a discreci\xF3n del guardia determinar si la persona estaba
    cometiendo el crimen y reportarlo apropiadamente.\r\n\r\nLa autorizaci\xF3n de
    fuerza letal ciudadanos que presenten cualquier de los siguientes s\xEDntomas
    se mantiene:\r\n-Piel p\xE1lida\r\n-Impedimento del habla\r\n-P\xE9rdida de cognici\xF3n\r\n-Hyper
    agresividad\r\n-P\xE9rdida de sensibilidad al dolor\r\n\r\nFuerza en fe y en
    el perd\xF3n de los dioses"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d806b8e522497cd4395314ac86af8fc1, type: 2}
