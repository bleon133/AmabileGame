  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Se llevaron a Robert durante la noche, yo mismo lo vi entre mis ventanas,
    el mism\xEDsimo herrero vino con un s\xE9quito de guardias para llev\xE1rselo,
    se le ve\xEDa d\xE9bil, crees que tambi\xE9n lo afect\xF3? siquiera los ogros
    pueden enfermarse por esto? incluso los guardias ahora est\xE1n cayendo como
    moscas, tratar con enfermos todo los d\xEDas eventualmente los tiene que afectar,
    sin importar que tanto elixir beban.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d806b8e522497cd4395314ac86af8fc1, type: 2}
  m_sharedMaterial: {fileID: -5276391410185949984, guid: d806b8e522497cd4395314ac86af8fc1, type: 2}
