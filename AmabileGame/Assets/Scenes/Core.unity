  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "para mi familia, si es que pueden leer esto, no era mi intenci\xF3n que
    esto llegara a este punto, nunca pens\xE9 que las consecuencias ser\xEDan tan
    grandes, todo lo que hice lo hice por ustedes, nunca pens\xE9 que ser\xEDa el
    precio que pagar\xEDa.\r\n\r\npara los guardias que encuentren mi cuerpo, no
    sufro de ning\xFAn tipo de sintoma de infeccion, no tienen que lanzar mi cad\xE1ver
    con los otros, pueden dejarme aqu\xED, en el hogar donde pase mi vida con toda
    mi familia, tampoco lo tienen que limpiar, ya no queda nadie a quien pueda molestar\r\n\r\npara
    mis vecinos en busca de suministros, aqu\xED no queda nada, pueden buscar pero
    toda la comida se acab\xF3, pueden tomar mis herramientas pero no creo que les
    sirva de mucho en estas tierras muertas.\r\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d806b8e522497cd4395314ac86af8fc1, type: 2}
