  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Por decreto del rey todos los granjeros est\xE1n ordenados de incrementar
    producci\xF3n de granos, la p\xE9rdida de personal no es excusa para detener
    producci\xF3n, estamos en un momento de incre\xEDbles necesidades y esperamos
    que hagan su parte, como todos los dem\xE1s lo est\xE1n haciendo, luego habr\xE1
    tiempo de llorar a los muertos.\r\n\r\nSi alg\xFAn granjero se encuentra rehusando
    a trabajar ser\xE1 arrestado por los guardias y un ciudadano elegido se le encarga
    cuidar de la tierra para asegurarse que haya suficiente grano para todos.\r\n\r\nCualquier
    persona acusada de estar ilegalmente guardando m\xE1s cultivos de los permitido
    ser\xE1 sometida a una b\xFAsqueda exhaustiva de su hogar, de ser hallada culpable
    sera inmediatamente arrestada por los guardias.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d806b8e522497cd4395314ac86af8fc1, type: 2}
  m_sharedMaterial: {fileID: -5276391410185949984, guid: d806b8e522497cd4395314ac86af8fc1, type: 2}
