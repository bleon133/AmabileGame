      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1911580783062292065, guid: 7241422f7f2f31f4b81b43b01b03e03d, type: 3}
      propertyPath: player
      value: 
      objectReference: {fileID: 1622695578}
    - target: {fileID: 1911580783062292065, guid: 7241422f7f2f31f4b81b43b01b03e03d, type: 3}
      propertyPath: cartaId
      value: perg-1
      objectReference: {fileID: 0}
    - target: {fileID: 1911580783062292065, guid: 7241422f7f2f31f4b81b43b01b03e03d, type: 3}
      propertyPath: textoPergamino
      value: "Aviso a todos los guardias a cargo de mantener el orden en el mercado.\r\n\r\nLa
        entrada queda restringida \xFAnicamente a personal de la guardia y trabajadores
        encargados de la distribuci\xF3n de suministros, los trabajadores deben tener
        sus papeles en orden, la tolerancia para discrepancias es zero.\r\n\r\nNos
        han otorgado autorizaci\xF3n para usar fuerza letal en cualquier ciudadanos
        que se encuentre cometiendo los siguientes cr\xEDmenes:\r\n-Robo de suministros
        de alta importancia como comida o agua potable\r\n-En posesi\xF3n de cualquier
        tipo de arma o de objeto que podr\xEDa ser interpretado como arma\r\n-Disrupci\xF3n
        de las labores de los guardias\r\n-Disrupci\xF3n de las labores de los trabajadores\r\n-Participaci\xF3n
        en protestas\r\n-Actitudes sediciosas no espec\xEDficas\r\n\r\nDebido a la
        falta de un jurado queda a discreci\xF3n del guardia determinar si la persona
        estaba cometiendo el crimen y reportarlo apropiadamente.\r\n\r\nLa autorizaci\xF3n
        de fuerza letal ciudadanos que presenten cualquier de los siguientes s\xEDntomas
        se mantiene:\r\n-Piel p\xE1lida\r\n-Impedimento del habla\r\n-P\xE9rdida
        de cognici\xF3n\r\n-Hyper agresividad\r\n-P\xE9rdida de sensibilidad al dolor\r\n\r\nFuerza
        en fe y en el perd\xF3n de los dioses\r"
      objectReference: {fileID: 0}
