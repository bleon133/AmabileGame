--- !u!1001 &1583105163
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1188596711}
    m_Modifications:
    - target: {fileID: 309826981638720844, guid: 7241422f7f2f31f4b81b43b01b03e03d, type: 3}
      propertyPath: m_LocalRotation.w
