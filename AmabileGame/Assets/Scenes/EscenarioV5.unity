      propertyPath: player
      value: 
      objectReference: {fileID: 1622695578}
    - target: {fileID: 1911580783062292065, guid: 7241422f7f2f31f4b81b43b01b03e03d, type: 3}
      propertyPath: cartaId
      value: perg-6
      objectReference: {fileID: 0}
    - target: {fileID: 1911580783062292065, guid: 7241422f7f2f31f4b81b43b01b03e03d, type: 3}
      propertyPath: textoPergamino
      value: "Por decreto del rey todos los granjeros est\xE1n ordenados de incrementar
        producci\xF3n de granos, la p\xE9rdida de personal no es excusa para detener
        producci\xF3n, estamos en un momento de incre\xEDbles necesidades y esperamos
        que hagan su parte, como todos los dem\xE1s lo est\xE1n haciendo, luego habr\xE1
        tiempo de llorar a los muertos.\r\n\r\nSi alg\xFAn granjero se encuentra
        rehusando a trabajar ser\xE1 arrestado por los guardias y un ciudadano elegido
        se le encarga cuidar de la tierra para asegurarse que haya suficiente grano
        para todos.\r\n\r\nCualquier persona acusada de estar ilegalmente guardando
        m\xE1s cultivos de los permitido ser\xE1 sometida a una b\xFAsqueda exhaustiva
        de su hogar, de ser hallada culpable sera inmediatamente arrestada por los
        guardias.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 7542819148604443937, guid: 7241422f7f2f31f4b81b43b01b03e03d, type: 3}
      propertyPath: m_Pivot.x
